# ======================================================================
# Shared
# ======================================================================
KAFKA_BROKERS=localhost:29092
TOPIC_VIDEO_JOBS=video-jobs
LOG_LEVEL=debug

# ======================================================================
# scanner-service (producer)
# ======================================================================
# Directory the scan starts from. `~` is expanded. NOTE: when running via
# `pnpm dev`/`start`, Node's --env-file loads THIS value, so set it here (a
# shell `SCAN_ROOT=... pnpm dev` gets overridden by the .env file).
SCAN_ROOT=~/
SCAN_MAX_DEPTH=64
VIDEO_EXTENSIONS=mp4,mov,mkv,avi,webm,m4v,mpg,mpeg,wmv,flv
SCANNER_GROUP_ID=scanners

# ======================================================================
# generator-service (consumer)
# ======================================================================
GENERATOR_GROUP_ID=thumbnail-generators
KAFKA_FROM_BEGINNING=true

# output
OUTPUT_ROOT=./output
THUMBNAIL_FORMAT=jpg
# The shared "video DB" (one row per video). Written by the generator, the
# `synced` flag flipped by the sync-service. Repo root, beside tenants.json.
VIDEO_DB_PATH=../../videoDb.jsonl

# generation behaviour
GENERATE_CONCURRENCY=4
GENERATE_TIMEOUT_MS=120000
GENERATE_MAX_RETRIES=2
GENERATE_FORCE=false
BACKOFF_BASE_MS=100
BACKOFF_FACTOR=2

# ffmpeg adapter
FFMPEG_PATH=ffmpeg
THUMBNAIL_TIMESTAMP=00:00:01
KILL_SIGNAL=SIGKILL

# lifecycle
SHUTDOWN_GRACE_MS=300

# ======================================================================
# sync-service (consumer)
# ======================================================================
# Consumes thumbnail-ready, "syncs" each thumbnail (logs it), and flips the
# video's `synced` flag in the shared video DB (VIDEO_DB_PATH above).
SYNC_GROUP_ID=thumbnail-syncers
# Simulated transfer latency per thumbnail (ms) so the daemon visibly works.
SYNC_DELAY_MS=0
