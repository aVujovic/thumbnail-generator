{
  "name": "sync-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/service.ts",
  "scripts": {
    "start": "node --import tsx --env-file-if-exists=../../.env src/service.ts",
    "dev": "node --watch-path=./src --import tsx --env-file-if-exists=../../.env src/service.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@thumbnailer/contracts": "workspace:*",
    "@thumbnailer/core": "workspace:*",
    "@thumbnailer/domain": "workspace:*",
    "awilix": "^12.0.5",
    "kafkajs": "^2.2.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
